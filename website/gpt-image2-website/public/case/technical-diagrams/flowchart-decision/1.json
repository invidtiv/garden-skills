{
  "type": "Engineering Style Flowchart / Decision Diagram",
  "goal": "Generate a 3:4 vertical dark-themed diagram, displaying the complete registration process and risk control branches.",
  "canvas": {
    "aspect_ratio": "3:4",
    "background": "deep slate #0F172A with subtle 1px grid #1E293B at 32px spacing",
    "outer_padding": "60px"
  },
  "title_strip": {
    "title": "User registration and activation process",
    "subtitle": "SMS OTP + email + device risk control",
    "position": "top-left, JetBrains Mono"
  },
  "flow_direction": "top-to-bottom",
  "shape_legend": "Consistent with the template (start/end circles/pills, process rectangles, decision diamonds, IO parallelograms, sub-process double boxes)",
  "nodes": {
    "count": "Half-body from chest to waist, shoulder line horizontal.",
    "items": [
      {
        "id": "S",
        "type": "start_end",
        "label": "Start"
      },
      {
        "id": "I1",
        "type": "io",
        "label": "User submits phone number + password + device fingerprint device_id"
      },
      {
        "id": "P1",
        "type": "process",
        "label": "Verify E.164 and password strength (zxcvbn≥3)"
      },
      {
        "id": "D1",
        "type": "decision",
        "label": "Is the phone number registered?"
      },
      {
        "id": "P2",
        "type": "process",
        "label": "Return to 409 and prompt for WeChat one-click login."
      },
      {
        "id": "P3",
        "type": "process",
        "label": "Create users row status = PENDING"
      },
      {
        "id": "D2",
        "type": "decision",
        "label": "Risk control score risk_score < 0.4?"
      },
      {
        "id": "SP1",
        "type": "subprocess",
        "label": "Sub-process: Enter manual queue_id risk control review"
      },
      {
        "id": "P4",
        "type": "process",
        "label": "SMS gateway sends 6-digit OTP (5min TTL)"
      },
      {
        "id": "D3",
        "type": "decision",
        "label": "Is the OTP consistent with the digest in Redis?"
      },
      {
        "id": "P5",
        "type": "process",
        "label": "Send verification email containing token (HKDF-SHA256)"
      },
      {
        "id": "D4",
        "type": "decision",
        "label": "Click verification link within 24h?"
      },
      {
        "id": "P6",
        "type": "process",
        "label": "Status= VERIFIED, email_verified_at written"
      },
      {
        "id": "P7",
        "type": "process",
        "label": "Delete expired token + soft delete unactivated"
      },
      {
        "id": "E",
        "type": "start_end",
        "label": "End"
      }
    ]
  },
  "edges": {
    "items": [
      {
        "from": "S",
        "to": "I1"
      },
      {
        "from": "I1",
        "to": "P1"
      },
      {
        "from": "P1",
        "to": "D1"
      },
      {
        "from": "D1",
        "to": "P2",
        "label": "Yes"
      },
      {
        "from": "D1",
        "to": "P3",
        "label": "No"
      },
      {
        "from": "P2",
        "to": "E"
      },
      {
        "from": "P3",
        "to": "D2"
      },
      {
        "from": "D2",
        "to": "SP1",
        "label": "No"
      },
      {
        "from": "D2",
        "to": "P4",
        "label": "Yes"
      },
      {
        "from": "SP1",
        "to": "E"
      },
      {
        "from": "P4",
        "to": "D3"
      },
      {
        "from": "D3",
        "to": "P5",
        "label": "Yes"
      },
      {
        "from": "D3",
        "to": "E",
        "label": "No"
      },
      {
        "from": "P5",
        "to": "D4"
      },
      {
        "from": "D4",
        "to": "P6",
        "label": "Yes"
      },
      {
        "from": "D4",
        "to": "P7",
        "label": "No"
      },
      {
        "from": "P6",
        "to": "E"
      },
      {
        "from": "P7",
        "to": "E"
      }
    ],
    "edge_style": {
      "default": "Slate 1.5px + triangular arrow",
      "yes_branch": "emerald #34D399",
      "no_branch": "slate",
      "exception_branch": {
        "enabled": "true",
        "style": "dashed rose",
        "use_on": "D3=No Quick exit"
      }
    }
  },
  "swim_lanes": {
    "enabled": "false"
  },
  "legend": {
    "enabled": true,
    "position": "bottom-right"
  },
  "constraints": {
    "must_keep": [
      "Decisions must have Yes/No or equivalent labels",
      "Sub-process is a double frame"
    ],
    "avoid": [
      ">15 nodes"
    ]
  }
}